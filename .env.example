# Copy to .env (git-ignored) and fill in. Never commit .env, never paste these into chat or a PR.

# Public RPCs work for reads and fork tests. A keyed URL is a secret.
BSC_RPC_URL=https://bsc-dataseed.bnbchain.org
BSC_TESTNET_RPC_URL=https://data-seed-prebsc-1-s1.bnbchain.org:8545

# Etherscan v2 key, covers BscScan and testnet BscScan (OP-8)
ETHERSCAN_API_KEY=

# Deployer wallet, used only for deploys (OP-4)
DEPLOYER_PRIVATE_KEY=

# Keeper wallet, only sends settle and score (OP-5). In CI it is the KEEPER_PRIVATE_KEY secret (OP-6).
KEEPER_PRIVATE_KEY=

# Fixed addresses on BSC mainnet (chain 56)
AGENT_ID_ADDRESS=0x60b9262456de011f7d15a54cdd8c48baaa8b022f
CHAINLINK_BNB_USD=0x0567F2323251f0Aab15c8dFb1967E4e8A7D42aeE
